namespace OrganizationsKitTests;

using Osysharp.Identity;
using Osysharp.Organizations;

// A supplier's portal. Its own people (staff) look after the companies; a company's people see their own company, and a
// company's BUYER may place orders for it — a role held at that company and nowhere else.

[Role] enum PortalRole { Authenticator, Staff, Buyer, Viewer }

policy IsStaff => RoleGrant.Any(g => g.Member == user && g.Role == PortalRole.Staff);
/// The kit's question, answered by the app: staff look after the companies.
policy ManagesOrganizations => IsStaff;

/// The app's own kind of account — signs in with a code, which is all a test needs.
entity Person : Principal {
  [MaxLength(200)] string CodeHash = "";
  security {
    allow read when IsAuthenticated || IsAuthenticator;
    allow create when IsAuthenticator;
    allow update when IsAuthenticated || IsAuthenticator where Id == user.Id;
    allow update when IsAuthenticator;
    deny read CodeHash when !IsAuthenticator;
  }
}

/// A customer company — the kit's base, with what the supplier keeps about it.
entity Company : Organization {
  [MaxLength(40)] string AccountNumber = "";
  security {
    allow read when IsStaff || IsAuthenticator;
    allow read when IsOrganizationMember where IsMemberOf(this);
    allow create, update when IsStaff;
    // A company's buyer keeps its details up to date.
    allow update when IsOrganizationMember where HoldsRoleIn(this, PortalRole.Buyer);
  }
}

/// A team of the supplier's own staff.
entity Team : Organization {
  security { allow read, create, update when IsStaff; }
}

/// An order a company places — by one of its buyers, and seen by its people.
entity PurchaseOrder {
  [Required("Say which company the order is for.")] Company Company;
  [MaxLength(80)] string Reference;
  security {
    allow read when IsStaff;
    allow read when IsOrganizationMember where IsMemberOf(Company);
    allow create where HoldsRoleIn(Company, PortalRole.Buyer);
  }
}

/// Sign in with an address and a code — and, as every sign-in does here, join the company whose domain a PROVEN address
/// is on.
[AuthMethod]
string SignInWithCode(string email, string code) {
  var p = Person.FirstOrDefault(x => x.Email == NormalisedEmail(email));
  if (p == null || !p.IsActive) { Security.VerifyPassword(code); return ""; }
  if (!Security.VerifyPassword(code, p.CodeHash)) { return ""; }
  JoinByDomain(p);
  return Security.IssueJwt(p.Id, p.Email);
}

app.AuthBootstrap = new AuthBootstrap { Role = PortalRole.Authenticator, Login = SignInWithCode };
app.Auth = new PasswordAuth { LoginField = Email, PasswordField = CodeHash };
app.Audit = new AuditConfig { Redact = new AuditRedaction { Properties = [OrganizationsKitTests.Person.CodeHash] } };

/// What a company's own admin may do in the app's rules — a buyer adds the company's people. An ordinary grant over the
/// kit's types, ORed with the kit's own: the kit's floors (no self-granted role, no Authenticator) still hold.
partial entity Membership { security { allow create, update where HoldsRoleIn(Organization, PortalRole.Buyer); } }
partial entity MembershipRole { security { allow create where HoldsRoleIn(Membership.Organization, PortalRole.Buyer); } }
