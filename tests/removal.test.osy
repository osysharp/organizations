// Taking a person out of an organisation — or leaving it. Recorded, mailed, the app told, the last buyer kept, their access
// ended at once, and their account left alone.
// SECURITY-INVARIANT(organizations-a-removal-is-asked-by-its-remover).

using Osysharp.Identity;
using Osysharp.Organizations;
using Osysharp.Mail;
using Osysharp.Workflow;
using OrganizationsKitTests;

[TestFixture]
void Acme() {
  var sam = new Person { Email = "sam@supplier.test", DisplayName = "Sam", CodeHash = Security.HashPassword("1111"),
                         EmailVerifiedAt = DateTime.UtcNow };
  new RoleGrant { Member = sam, Role = PortalRole.Staff };
  var acme = new Company { Name = "Acme" };
  new OrganizationDomain { Organization = acme, Domain = "acme.com" };
  var bea = new Person { Email = "bea@acme.com", DisplayName = "Bea", CodeHash = Security.HashPassword("4444"), EmailVerifiedAt = DateTime.UtcNow };
  var ada = new Person { Email = "ada@acme.com", DisplayName = "Ada", CodeHash = Security.HashPassword("2222"), EmailVerifiedAt = DateTime.UtcNow };
  var ivo = new Person { Email = "ivo@acme.com", DisplayName = "Ivo", CodeHash = Security.HashPassword("5555"), EmailVerifiedAt = DateTime.UtcNow };
  var mb = new Membership { Organization = acme, Member = bea };
  new MembershipRole { Membership = mb, Role = PortalRole.Buyer };
  new Membership { Organization = acme, Member = ada };
  new Membership { Organization = acme, Member = ivo, Source = MembershipSource.Scim, ExternalId = "scim-ivo" };
  new CompanyDesk { Company = acme, Holder = ada };
}

principal Sam => Person.Single(p => p.Email == "sam@supplier.test");
principal Bea => Person.Single(p => p.Email == "bea@acme.com");
principal Ada => Person.Single(p => p.Email == "ada@acme.com");
principal Ivo => Person.Single(p => p.Email == "ivo@acme.com");

[Test(Acme)]
void a_manager_takes_a_person_out_and_it_is_recorded_mailed_and_their_access_ends_at_once() {
  // Ada reads her company before — so an answer about her is held, and must not outlive the removal.
  runas (Ada) { Assert.Equal(1, Company.Count()); }
  MembershipRemoval? removal = null;
  runas (Sam) { removal = RemoveMember(Company.Single(c => c.Name == "Acme"), Ada); }
  Workflow.Settle(removal!);
  runas (Sam) {
    Assert.False(Membership.Any(m => m.Member == Ada));
    // The app was told, in the same write: her desk at Acme is gone.
    Assert.False(CompanyDesk.Any(d => d.Holder == Ada));
    var r = MembershipRemoval.Single(x => x.Member == Ada);
    Assert.Equal(MembershipRemovalState.Removed, r.State);
    Assert.Equal("sam@supplier.test", r.RemovedBy.Email);
    Assert.Equal("Acme", r.Organization.Name);
  }
  // Her next request reads nothing of Acme.
  runas (Ada) {
    Assert.Equal(0, Company.Count());
    Assert.Equal(0, Membership.Count());
  }
  // She is told who removed her, and that her account remains.
  runas (AuthBootstrap) {
    var mail = OutgoingMail.Single(m => m.To == "ada@acme.com" && m.Subject == "You were removed from Acme");
    Assert.True(mail.Text!.Contains("Sam removed you from Acme"));
    Assert.True(mail.Text!.Contains("Your account remains"));
  }
  // Removal is not erasure: the account is still there, and still signs in.
  runas (AuthBootstrap) { Assert.NotEqual("", SignInWithCode("ada@acme.com", "2222")); }
}

[Test(Acme)]
void a_person_leaves_by_themself_and_is_not_mailed() {
  MembershipRemoval? removal = null;
  runas (Ada) { removal = RemoveMember(Company.Single(c => c.Name == "Acme"), Ada); }
  Workflow.Settle(removal!);
  runas (Ada) { Assert.Equal(0, Company.Count()); }
  runas (Sam) { Assert.Equal("ada@acme.com", MembershipRemoval.Single(x => x.Member == Ada).RemovedBy.Email); }
  runas (AuthBootstrap) { Assert.Equal(0, OutgoingMail.Count(m => m.To == "ada@acme.com")); }
}

[Test(Acme)]
void a_member_cannot_take_somebody_else_out() {
  runas (Ada) {
    var acme = Company.Single(c => c.Name == "Acme");
    Assert.Denied(() => new MembershipRemoval { Organization = acme, Member = Bea, RemovedBy = Ada });
    // …nor record the removal as somebody else's.
    Assert.Denied(() => new MembershipRemoval { Organization = acme, Member = Ada, RemovedBy = Sam });
  }
  runas (Sam) { Assert.True(Membership.Any(m => m.Member == Bea)); }
}

[Test(Acme)]
void the_last_buyer_is_kept_and_refused_by_name() {
  runas (Sam) {
    var acme = Company.Single(c => c.Name == "Acme");
    var e = Assert.Throws<ValidationException>(() => RemoveMember(acme, Bea));
    Assert.Equal("Bea is the last buyer of Acme — make someone else its buyer first.", e.Message);
  }
  runas (Bea) {
    Assert.Throws<ValidationException>(() => RemoveMember(Company.Single(c => c.Name == "Acme"), Bea));
  }
  // With a second buyer, she may go.
  MembershipRemoval? removal = null;
  runas (Sam) {
    var acme = Company.Single(c => c.Name == "Acme");
    GrantIn(acme, Ada, PortalRole.Buyer);
    UnitOfWork.Commit();
    removal = RemoveMember(acme, Bea);
  }
  Workflow.Settle(removal!);
  runas (Sam) {
    Assert.False(Membership.Any(m => m.Member == Bea));
    Assert.False(MembershipRole.Any(g => g.Membership.Member == Bea));
  }
}

[Test(Acme)]
void a_membership_the_directory_made_is_removed_there() {
  runas (Sam) {
    var e = Assert.Throws<ValidationException>(() => RemoveMember(Company.Single(c => c.Name == "Acme"), Ivo));
    Assert.True(e.Message.Contains("remove them there"));
    Assert.True(Membership.Any(m => m.Member == Ivo));
  }
}

[Test(Acme)]
void a_person_taken_out_does_not_walk_back_in_by_their_address() {
  MembershipRemoval? removal = null;
  runas (Sam) { removal = RemoveMember(Company.Single(c => c.Name == "Acme"), Ada); }
  Workflow.Settle(removal!);
  runas (AuthBootstrap) { SignInWithCode("ada@acme.com", "2222"); }
  runas (Ada) { Assert.Equal(0, Company.Count()); }
  // …but brought back on purpose, she is in again.
  runas (Sam) { Join(Company.Single(c => c.Name == "Acme"), Ada); }
  UnitOfWork.Commit();
  runas (Ada) { Assert.Equal(1, Company.Count()); }
}
